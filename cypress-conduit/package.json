{
  "name": "cypress-conduit",
  "scripts": {
    "delete:reports": "rm cypress/reports/* || true ",
    "prereport": "npm run delete:reports",
    "junit:merge": "npx junit-merge -d cypress/reports/junit -o cypress/reports/junit/results.xml",
    "cy_run_dev": "npx cypress open --env username='helloDEV@test.com',password='123123'",
    "cy_run_QA": "npx cypress open --env username=$USER_NAME,password=$PASSWORD",
    "cy:run:all": "npm run prereport && npx cypress run || true && npm run junit:merge"
  },
  "devDependencies": {
    "@cypress/grep": "^6.0.2",
    "@faker-js/faker": "^10.5.0",
    "cypress": "^15.19.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "cypress-multi-reporters": "^2.0.5",
    "junit-merge": "^2.0.0",
    "mocha-junit-reporter": "^2.2.1"
  }
}
