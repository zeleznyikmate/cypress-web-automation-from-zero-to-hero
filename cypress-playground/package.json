{
  "name": "cypress-playground",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress:smoke-firefox": "npx cypress run --spec 'cypress/e2e/firstTest.cy.js' --browser firefox",
    "cypress:smoke-chrome": "npx cypress run --spec 'cypress/e2e/firstTest.cy.js' --browser chrome",
    "cypress:smoke-all": "npm run cypress:smoke-firefox && cypress:smoke-chrome"
  },
  "devDependencies": {
    "cypress": "^15.18.1"
  }
}
